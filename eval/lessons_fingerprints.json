    {
      "id": "FP-01",
      "lesson": "数据层生成器必须四道防线 (lessons-p0 #7)",
      "category": "数据安全",
      "trigger_actions": [
        "生成/覆盖 json/索引/数据层文件",
        "跑 scan_skills/auto-fix 类生成器"
      ],
      "target_files": [
        "<MEMORY_ROOT>\\scripts\\*.ps1",
        "*.py"
      ],
      "checks": [
        {
          "type": "contains_any",
          "patterns": [
            "KNOWN_DOMAINS",
            "notin $KNOWN_DOMAINS"
          ],
          "note": "防线1 白名单"
        },
        {
          "type": "contains_any",
          "patterns": [
            "Count -eq 0",
            "跳过写入"
          ],
          "note": "防线2 写前校验"
        },
        {
          "type": "contains_all",
          "patterns": [
            ".tmp",
            "Move-Item"
          ],
          "note": "防线3 原子替换"
        },
        {
          "type": "contains_any",
          "patterns": [
            "写后校验",
            "守恒"
          ],
          "note": "防线4 守恒校验"
        }
      ],
      "hit_rule": "全部 check 通过 = 命中 (真用上)"
    },
    {
